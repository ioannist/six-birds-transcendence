import CSTTT.Targets.GenericHandoff.GameFiniteConstructor

/-! The hybrid invariant constructor is complete as a proof-bearing run-space
constructor. This does NOT assert completeness of a finite projection. A causal
strategy supplies its actual reachable-play invariant; no unchosen action is
required safe and no run context is forgotten. -/
namespace CSTTT.TargetTheory.GenericHandoff.StrategyGame
variable {Run Disturbance Action Outcome : Type}

/-- Reachability is generated by the actual strategy and actual support. -/
def StrategyReachable (rows : Rows Run Disturbance Action Outcome)
    (update : Updater Run Disturbance Action Outcome)
    (entries : Run → Prop) (strategy : Strategy Run Disturbance Action) (r : Run) : Prop :=
  ∃ entry, entries entry ∧ ∃ past, Play rows update strategy entry (r :: past)

theorem game_invariant_completeness
    {rows : Rows Run Disturbance Action Outcome}
    {update : Updater Run Disturbance Action Outcome}
    {entries : Run → Prop} {withdrawal : Prop}
    {package resourceClosed : Run → Prop}
    {responseLegal : Run → Disturbance → Action → Prop}
    {transitionLaw : Run → Disturbance → Action → Outcome → Prop}
    (h : GameReadout rows update entries withdrawal package resourceClosed responseLegal transitionLaw) :
    Nonempty (InvariantCertificate rows update entries withdrawal package resourceClosed responseLegal transitionLaw) := by
  obtain ⟨hw,he,strategy,hs⟩ := h
  refine ⟨{
    inside := StrategyReachable rows update entries strategy
    withdrawn := hw
    entriesNonempty := he
    entriesInside := fun r hr => ⟨r,hr,[],Play.initial⟩
    packageInside := ?_
    resourcesInside := ?_
    response := ?_ }⟩
  · rintro r ⟨entry,he,past,hp⟩
    exact (hs entry he r past hp).1
  · rintro r ⟨entry,he,past,hp⟩
    exact (hs entry he r past hp).2.1
  · rintro r ⟨entry,he,past,hp⟩ d
    have hh := (hs entry he r past hp).2.2 d
    exact ⟨strategy (r :: past) d,hh.1,hh.2.1,
      fun o ho => ⟨⟨entry,he,r :: past,Play.step hp d o ho⟩,hh.2.2 o ho⟩⟩

theorem game_iff_run_invariant
    {rows : Rows Run Disturbance Action Outcome}
    {update : Updater Run Disturbance Action Outcome}
    {entries : Run → Prop} {withdrawal : Prop}
    {package resourceClosed : Run → Prop}
    {responseLegal : Run → Disturbance → Action → Prop}
    {transitionLaw : Run → Disturbance → Action → Outcome → Prop} :
    GameReadout rows update entries withdrawal package resourceClosed responseLegal transitionLaw ↔
    Nonempty (InvariantCertificate rows update entries withdrawal package resourceClosed responseLegal transitionLaw) :=
  ⟨game_invariant_completeness,fun ⟨cert⟩ => invariant_game_soundness _ _ _ _ _ _ _ _ cert⟩

end CSTTT.TargetTheory.GenericHandoff.StrategyGame
