/-- Optional native input decoding follows the frozen event/stage rule. -/
def nativeInput (episode : FiniteAtomicLeg) : Assignment := fun id => do
  let event ← eventAt episode id
  let stage ← episode.stages[event.stage]?
  pure ⟨event.stage,some stage.frontier,some ⟨event.stage,false⟩,stage.realized,.live⟩

def overlapEpisode :=
  CSTTT.TargetTheory.GenericHandoff.NativeComposition.PublicationCorridor.canonicalLeg
    true ⟨false,false,false⟩ ["native-past"]

def overlapOnly : ControlModel :=
  ⟨overlapEpisode,nativeInput overlapEpisode,fun _ _ => .liveTemporal,[]⟩

def mixedSource := (exit overlapOnly.episode).frontier

def mixedReceiver : ReadoutUpdate :=
  ⟨0,1,1,1,1,["native-direct"],"funded",101⟩

/-- The declared target observation advances all fields of the whole native
exit; no reduced scalar or lossy hash substitutes for that frontier. -/
def mixedEpisode : FiniteAtomicLeg where
  source := 55
  target := 101
  stages := [⟨[55],true,mixedSource⟩,
    ⟨[101],true,advance mixedReceiver mixedSource⟩]
  events := [⟨"native-direct-source",55,0⟩,⟨"native-direct-target",101,1⟩]
  dependencies := [⟨"native-direct-source","native-direct-target"⟩]
  updates := [mixedReceiver]
  base := default
  sourceContribution := default
  targetContribution := default
  sourceAudit := "native-direct-source"
  targetAudit := "native-direct-target"
  laterAudit := ""

def mixedDirect : ControlModel :=
  ⟨mixedEpisode,fun id => if id="native-direct-source" then
    some ⟨0,some mixedSource,some ⟨4,false⟩,true,.live⟩ else none,
    fun _ _ => .liveTemporal,[]⟩

