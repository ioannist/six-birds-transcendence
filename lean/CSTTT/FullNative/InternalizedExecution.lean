import CSTTT.FullNative.AccountExecution
import CSTTT.Targets.GenericHandoff.NativeComposition.GeneratorCredit

/-! Actual account/packet execution of the independently frozen nine-state
random-scan control. Channel-labelled rows marginalize to the existing liftP;
this is a different carrier and process from FULL-NATIVE-01's full32 rows.
Content uses the resident local generator/token; the internalized clock uses
the existing bridge hardware/token3. Issuers are generated by that dispatch,
never supplied to the executor or credit readout. -/
namespace CSTTT.FullNative.Internalized
open AccountExecution
open CSTTT.TargetTheory.GenericHandoff.NativeComposition.NativeGeneratorCreditPrototype
set_option autoImplicit false
set_option maxHeartbeats 8000000
set_option maxRecDepth 8192

abbrev State := LiftState
inductive Flavor where
  | source | native
  deriving DecidableEq, Repr
inductive Channel where
  | content | clock
  deriving DecidableEq, Repr
def channels : List Channel := [.content,.clock]
def parameter : Flavor → Rat
  | .source => 2/3
  | .native => bias (CSTTT.TargetTheory.GenericHandoff.NativeComposition.CoupledNativeKernelPrototype.input false)
theorem parameters_exact : parameter .source=2/3 ∧ parameter .native=3/8 :=
  ⟨rfl,actual_bias false⟩
def part (f : Flavor) : Channel → State → State → Rat
  | .content => contentChannel (parameter f)
  | .clock => clockChannel

structure Program where
  weights : Channel → State → State → Rat
def program (f : Flavor) : Program := ⟨part f⟩

structure Receipt where
  issuer : Actor
  token : Token
  serial : Nat
  channel : Channel
  before : State
  after : State
  weight : Rat
  energy : Option Unit
  deriving DecidableEq, Repr

structure Execution where
  accounts : Accounts
  owner : Owner
  token : Token
  installed : Option Program
  current : State
  receipts : List Receipt

def dispatchToken (x : Execution) : Channel → Token
  | .content => x.token
  | .clock => 3
def dispatchActor (x : Execution) : Channel → Actor
  | .content => .localGenerator x.owner
  | .clock => .bridge
def active (x : Execution) (c : Channel) : Bool :=
  decide (x.accounts.allocation (dispatchToken x c)=some (dispatchActor x c)) &&
    x.accounts.charge (dispatchToken x c)
def issue (supply : Supply) (x : Execution) (c : Channel) (t : State) (w : Rat) : Receipt :=
  ⟨dispatchActor x c,dispatchToken x c,
    4*x.accounts.portCursor (dispatchToken x c)+(dispatchToken x c).val,
    c,x.current,t,w,supply (dispatchToken x c) (x.accounts.portCursor (dispatchToken x c))⟩
def advance (supply : Supply) (x : Execution) (c : Channel) (t : State) (w : Rat) : Execution :=
  {x with
    accounts := transact supply x.accounts (dispatchToken x c)
    current := t
    receipts := issue supply x c t w :: x.receipts}
def rawRows (supply : Supply) (x : Execution) : List (Execution × Rat) :=
  match x.installed with
  | none => []
  | some d => channels.flatMap fun c => if active x c then
      (liftStates.filter fun t => decide (0<d.weights c x.current t)).map fun t =>
        (advance supply x c t (d.weights c x.current t),d.weights c x.current t)
    else []
def physicalRows (f : Flavor) (s : State) : List ((Channel × State) × Rat) :=
  channels.flatMap fun c => (liftStates.filter fun t => decide (0<part f c s t)).map
    fun t => ((c,t),part f c s t)

def Funded (f : Flavor) (x : Execution) : Prop :=
  x.installed=some (program f) ∧ x.token≠3 ∧
    x.accounts.allocation x.token=some (.localGenerator x.owner) ∧
    x.accounts.allocation 3=some .bridge ∧
    x.accounts.charge x.token=true ∧ x.accounts.charge 3=true

theorem funded_active (f : Flavor) (x : Execution) (h : Funded f x) (c : Channel) :
    active x c=true := by
  cases c <;> simp [active,dispatchToken,dispatchActor,h.2.2.1,h.2.2.2.1,
    h.2.2.2.2.1,h.2.2.2.2.2]

theorem funded_advance (f : Flavor) (x : Execution) (h : Funded f x)
    (c : Channel) (t : State) (w : Rat) : Funded f (advance renewable x c t w) := by
  refine ⟨h.1,h.2.1,h.2.2.1,h.2.2.2.1,?_,?_⟩
  cases c <;> simp [advance,dispatchToken,transact,debit,put,h.2.1,h.2.2.2.2.1,renewable]
  cases c <;> simp [advance,dispatchToken,transact,debit,put,Ne.symm h.2.1,h.2.2.2.2.2,renewable]

theorem funded_rows (f : Flavor) (x : Execution) (h : Funded f x) (supply : Supply) :
    rawRows supply x=(physicalRows f x.current).map fun e =>
      (advance supply x e.1.1 e.1.2 e.2,e.2) := by
  simp [rawRows,h.1,funded_active f x h,physicalRows,program,List.map_flatMap,List.map_map,
    Function.comp_def]

theorem supported_step (supply : Supply) (x y : Execution) (w : Rat)
    (edge : (y,w)∈rawRows supply x) :
    ∃ d c t, x.installed=some d ∧ c∈channels ∧ active x c=true ∧
      t∈liftStates ∧ 0<d.weights c x.current t ∧
      y=advance supply x c t (d.weights c x.current t) ∧ w=d.weights c x.current t := by
  cases hp : x.installed with
  | none => simp [rawRows,hp] at edge
  | some d =>
    simp only [rawRows,hp] at edge
    obtain ⟨c,hc,edge⟩ := List.mem_flatMap.mp edge
    split at edge
    · rename_i enabled
      obtain ⟨t,ht,eq⟩ := List.mem_map.mp edge
      have positive := List.mem_filter.mp ht
      exact ⟨d,c,t,rfl,hc,enabled,positive.1,of_decide_eq_true positive.2,
        (congrArg Prod.fst eq).symm,(congrArg Prod.snd eq).symm⟩
    · simp at edge

theorem funded_successor (f : Flavor) (x y : Execution) (h : Funded f x) (w : Rat)
    (edge : (y,w)∈rawRows renewable x) : Funded f y := by
  obtain ⟨d,c,t,_,_,_,_,_,rfl,_⟩ := supported_step _ _ _ _ edge
  exact funded_advance f x h c t _

inductive Closure (supply : Supply) (root : Execution) : Execution → Prop where
  | root : Closure supply root root
  | step {x y : Execution} {w : Rat} :
      Closure supply root x → (y,w)∈rawRows supply x → Closure supply root y

theorem closure_funded (f : Flavor) (root x : Execution) (h : Funded f root)
    (reach : Closure renewable root x) : Funded f x := by
  induction reach with
  | root => exact h
  | step reach edge ih => exact funded_successor f _ _ ih _ edge

def root (f : Flavor) (o : Owner) : Execution :=
  ⟨canonical,o,⟨o.val,Nat.lt_trans o.isLt (by decide)⟩,some (program f),(.a,.a),[]⟩

theorem roots_funded (f : Flavor) (o : Owner) : Funded f (root f o) := by
  have cases : o=0 ∨ o=1 ∨ o=2 := by
    have bound:=o.isLt
    simp only [Fin.ext_iff]
    omega
  rcases cases with rfl | rfl | rfl <;> cases f <;>
    refine ⟨rfl,by decide,by decide,by decide,rfl,rfl⟩

theorem missing_program_rows (supply : Supply) (x : Execution) (missing : x.installed=none) :
    rawRows supply x=[] := by simp [rawRows,missing]

theorem disabled_channel (x : Execution) (c : Channel)
    (missing : x.accounts.allocation (dispatchToken x c)≠some (dispatchActor x c)) :
    active x c=false := by simp [active,missing]

theorem actual_receipt_step (supply : Supply) (x : Execution) (c : Channel) (t : State) (w : Rat) :
    (advance supply x c t w).receipts.head?=some (issue supply x c t w) ∧
    (issue supply x c t w).issuer=dispatchActor x c ∧
    (issue supply x c t w).token=dispatchToken x c ∧
    (issue supply x c t w).channel=c ∧
    (issue supply x c t w).energy=supply (dispatchToken x c) (x.accounts.portCursor (dispatchToken x c)) ∧
    (advance supply x c t w).accounts.portCursor (dispatchToken x c)=
      x.accounts.portCursor (dispatchToken x c)+1 ∧
    (advance supply x c t w).accounts.charge (dispatchToken x c)=
      (issue supply x c t w).energy.isSome :=
  ⟨rfl,rfl,rfl,rfl,rfl,cursor_after _ _ _,charge_after _ _ _⟩

theorem physical_marginal (f : Flavor) (s t : State) :
    ((physicalRows f s).map fun e => if e.1.2=t then e.2 else 0).sum=
      liftP (parameter f) s t := by
  cases f <;> rcases s with ⟨x,phase⟩ <;> rcases t with ⟨y,next⟩ <;>
    cases x <;> cases phase <;> cases y <;> cases next <;>
    decide +kernel

theorem actual_marginal (f : Flavor) (x : Execution) (h : Funded f x) (t : State) :
    ((rawRows renewable x).map fun e => if e.1.current=t then e.2 else 0).sum=
      liftP (parameter f) x.current t := by
  rw [funded_rows f x h,List.map_map]
  exact physical_marginal f x.current t

theorem physical_normalized (f : Flavor) (s : State) :
    ((physicalRows f s).map Prod.snd).sum=1 := by
  cases f <;> rcases s with ⟨x,phase⟩ <;> cases x <;> cases phase <;>
    decide +kernel

def Sector (x : Execution) : Prop :=
  x.token≠3 ∧ x.accounts.allocation x.token=some (.localGenerator x.owner) ∧
    x.accounts.allocation 3=some .bridge ∧
    x.accounts.charge x.token=true ∧ x.accounts.charge 3=true

def StepLaw (f : Flavor) (x : Execution) : Prop :=
  ∃ d, x.installed=some d ∧ ∀ c t, d.weights c x.current t=part f c x.current t

/-- Laws are tested throughout the closure generated by every positive actual
row, against the independently frozen component recipes at all nine outcomes. -/
def LawGate (f : Flavor) (r : Execution) : Prop :=
  r.receipts=[] ∧ ∀ x, Closure renewable r x → Sector x ∧ StepLaw f x

theorem funded_laws (f : Flavor) (x : Execution) (h : Funded f x) : Sector x ∧ StepLaw f x :=
  ⟨h.2,program f,h.1,fun _ _ => rfl⟩

theorem root_law_gate (f : Flavor) (o : Owner) : LawGate f (root f o) :=
  ⟨rfl,fun x reach => funded_laws f x (closure_funded f _ x (roots_funded f o) reach)⟩

theorem closure_law_mismatch_rejects (f : Flavor) (r x : Execution)
    (reach : Closure renewable r x) (bad : ¬ StepLaw f x) : ¬ LawGate f r :=
  fun gate => bad (gate.2 x reach).2

theorem closure_account_mismatch_rejects (f : Flavor) (r x : Execution)
    (reach : Closure renewable r x) (bad : ¬ Sector x) : ¬ LawGate f r :=
  fun gate => bad (gate.2 x reach).1

theorem sector_active (x : Execution) (h : Sector x) (c : Channel) : active x c=true := by
  cases c <;> simp [active,dispatchToken,dispatchActor,h.2.1,h.2.2.1,h.2.2.2.1,h.2.2.2.2]

theorem gated_rows (f : Flavor) (r x : Execution) (gate : LawGate f r)
    (reach : Closure renewable r x) : rawRows renewable x=(physicalRows f x.current).map
      fun e => (advance renewable x e.1.1 e.1.2 e.2,e.2) := by
  obtain ⟨sector,d,installed,law⟩ := gate.2 x reach
  simp [rawRows,installed,sector_active x sector,law,physicalRows,List.map_flatMap,
    List.map_map,Function.comp_def]

theorem gated_marginal (f : Flavor) (r x : Execution) (gate : LawGate f r)
    (reach : Closure renewable r x) (t : State) :
    ((rawRows renewable x).map fun e => if e.1.current=t then e.2 else 0).sum=
      liftP (parameter f) x.current t := by
  rw [gated_rows f r x gate reach,List.map_map]
  exact physical_marginal f x.current t

theorem absent_repeated_channel_disabled (x : Execution) (c : Channel) (t : State) (w : Rat) :
    active (advance absentSupply x c t w) c=false := by
  cases c <;> simp [active,advance,dispatchToken,dispatchActor,transact,debit,put,absentSupply]

theorem absent_two_channels_stop (x : Execution) (distinct : x.token≠3)
    (s t : State) (u v : Rat) :
    rawRows absentSupply (advance absentSupply (advance absentSupply x .content s u) .clock t v)=[] := by
  cases hp : x.installed <;>
    simp [rawRows,advance,active,dispatchToken,dispatchActor,channels,transact,debit,put,
      absentSupply,distinct,hp]

theorem state_mem (s : State) : s∈liftStates := by
  rcases s with ⟨x,p⟩
  cases x <;> cases p <;> decide +kernel

theorem gated_reverse_support (f : Flavor) (r x y : Execution) (gate : LawGate f r)
    (reach : Closure renewable r x) (w : Rat) (edge : (y,w)∈rawRows renewable x) :
    ∃ z, (z,w)∈rawRows renewable y ∧ z.current=x.current := by
  have next : Closure renewable r y := .step reach edge
  rw [gated_rows f r x gate reach] at edge
  obtain ⟨e,member,eq⟩ := List.mem_map.mp edge
  have state : y.current=e.1.2 := by
    have tip := congrArg (fun z : Execution × Rat => z.1.current) eq
    exact tip.symm
  have weight : w=e.2 := (congrArg Prod.snd eq).symm
  obtain ⟨c,hc,member⟩ := List.mem_flatMap.mp member
  obtain ⟨t,ht,equal⟩ := List.mem_map.mp member
  subst e
  have positive := of_decide_eq_true (List.mem_filter.mp ht).2
  have symmetry : part f c t x.current=part f c x.current t := by
    cases c
    · exact content_channel_symmetric _ t x.current
    · exact clock_channel_symmetric t x.current
  refine ⟨advance renewable y c x.current w,?_,rfl⟩
  rw [gated_rows f r y gate next]
  apply List.mem_map.mpr
  refine ⟨((c,x.current),w),?_,rfl⟩
  apply List.mem_flatMap.mpr
  refine ⟨c,hc,List.mem_map.mpr ⟨x.current,List.mem_filter.mpr ⟨state_mem x.current,?_⟩,?_⟩⟩
  · simpa [state,symmetry] using positive
  · simp [state,symmetry,weight]

end CSTTT.FullNative.Internalized
