{
  "$defs": {
    "carrier": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "label"
      ],
      "type": "object"
    }
  },
  "$id": "https://six-birds.local/cst-tt/schemas/autonomy_certificate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Names the withdrawal intervention and finite controlled-invariant certificate independently of ordinary runtime behavior.",
  "properties": {
    "anti_stall_status": {
      "enum": [
        "not-evaluated",
        "certified",
        "failed"
      ],
      "type": "string"
    },
    "bridge_removed": {
      "type": "boolean"
    },
    "budget_solvency_status": {
      "enum": [
        "not-evaluated",
        "certified",
        "failed"
      ],
      "type": "string"
    },
    "disturbance_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "endpoint_state_id": {
      "minLength": 1,
      "type": "string"
    },
    "external_decoder_removed": {
      "type": "boolean"
    },
    "external_scheduler_removed": {
      "type": "boolean"
    },
    "invariant_state_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "maintenance_ownership_status": {
      "enum": [
        "not-evaluated",
        "certified",
        "failed"
      ],
      "type": "string"
    },
    "migration_controller_removed": {
      "type": "boolean"
    },
    "package_inside_status": {
      "enum": [
        "not-evaluated",
        "certified",
        "failed"
      ],
      "type": "string"
    },
    "removed_resources": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "response_table_ref": {
      "minLength": 1,
      "type": "string"
    },
    "retained_resources": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "CST-TT-00"
    },
    "source_removed": {
      "type": "boolean"
    },
    "target": {
      "$ref": "#/$defs/carrier"
    },
    "undeclared_repair_removed": {
      "type": "boolean"
    }
