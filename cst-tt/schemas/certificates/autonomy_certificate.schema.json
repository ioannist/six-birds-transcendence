  "required": [
    "schema_version",
    "target",
    "endpoint_state_id",
    "removed_resources",
    "retained_resources",
    "disturbance_ids",
    "invariant_state_ids",
    "response_table_ref",
    "source_removed",
    "bridge_removed",
    "migration_controller_removed",
    "external_decoder_removed",
    "external_scheduler_removed",
    "undeclared_repair_removed",
    "package_inside_status",
    "anti_stall_status",
    "budget_solvency_status",
    "maintenance_ownership_status"
