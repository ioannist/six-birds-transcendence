{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://six-birds.local/cst-tt/schemas/package_control_certificate.schema.json",
  "title": "CST-TT-02 one-obligation-removed package control certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "control_id", "control_kind", "artifact_ref", "artifact_sha256",
    "expected_primary_failure", "observed_failures", "positive_baseline_ref",
    "result_status", "claim_ceiling", "checker"
  ],
  "properties": {
    "schema_version": {"const": "CST-TT-02"},
    "control_id": {"type": "string", "minLength": 1},
    "control_kind": {"enum": ["package", "staged-assembly"]},
    "artifact_ref": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_primary_failure": {"type": "string", "minLength": 1},
    "observed_failures": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "positive_baseline_ref": {"type": "string", "minLength": 1},
    "result_status": {"enum": ["scaffold-only", "checked-obligation-countermodel"]},
    "claim_ceiling": {"const": "finite package-obligation boundary only"},
    "checker": {"type": "object"}
  }
}
