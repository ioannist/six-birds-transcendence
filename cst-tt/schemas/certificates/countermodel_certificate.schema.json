{
  "$id": "https://six-birds.local/cst-tt/schemas/countermodel_certificate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finite countermodel certificate",
  "description": "Scaffold records remain valid; CST-TT-01 checked records additionally carry exact model hashes, exhaustive-search data, and checker references.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": ["CST-TT-00", "CST-TT-01"]
    },
    "countermodel_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "target_no_go_id": {
      "type": "string",
      "pattern": "^TTN-[0-9]{2}$"
    },
    "toy_model_ref": {
      "type": "string",
      "pattern": "^(TTM|TFM)-[0-9]{2}$"
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "finite_model_ref": {
      "type": "string",
      "minLength": 1
    },
    "finite_model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["S-T", "S-R", "S-L", "A", "R", "O", "M"]
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "premises_status": {
      "enum": ["not-evaluated", "certified", "failed"]
    },
    "conclusion_failure_status": {
      "enum": ["not-evaluated", "certified", "failed"]
    },
    "minimality_status": {
      "enum": ["not-evaluated", "certified", "failed"]
    },
    "result_status": {
      "enum": ["scaffold-only", "checked-finite-countermodel"]
    },
    "claim_ceiling": {
      "const": "structural-boundary-only"
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "ordering",
        "bound",
        "size_measure",
        "witness_size_vector",
        "candidates_explored",
        "qualifying_candidates",
        "smaller_candidates_explored",
        "same_size_candidates_explored",
        "same_size_qualifying_candidates",
        "minimality_result",
        "lower_bound_argument"
      ],
      "properties": {
        "algorithm": {"const": "deterministic-exhaustive-enumeration"},
        "ordering": {"type": "string", "minLength": 1},
        "bound": {"type": "string", "minLength": 1},
        "size_measure": {"type": "string", "minLength": 1},
        "witness_size_vector": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "candidates_explored": {"type": "integer", "minimum": 1},
        "qualifying_candidates": {"type": "integer", "minimum": 1},
        "smaller_candidates_explored": {"type": "integer", "minimum": 0},
        "same_size_candidates_explored": {"type": "integer", "minimum": 1},
        "same_size_qualifying_candidates": {"type": "integer", "minimum": 1},
        "minimality_result": {"const": "proved-by-exhaustive-bounded-search"},
        "lower_bound_argument": {"type": "string", "minLength": 1}
      }
    },
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_checker",
        "python_status",
        "lean_declaration",
        "lean_source_status",
        "lean_compile_status"
      ],
      "properties": {
        "python_checker": {"type": "string", "minLength": 1},
        "python_status": {"const": "passed"},
        "lean_declaration": {"type": "string", "minLength": 1},
        "lean_source_status": {"const": "explicit-proof-source-present"},
        "lean_compile_status": {"enum": ["pending-toolchain", "compiled"]}
      }
    }
  },
  "required": [
    "schema_version",
    "countermodel_id",
    "target_no_go_id",
    "finite_model_ref",
    "premises_status",
    "conclusion_failure_status",
    "minimality_status",
    "result_status",
    "claim_ceiling"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "result_status": {"const": "checked-finite-countermodel"}
        },
        "required": ["result_status"]
      },
      "then": {
        "properties": {
          "schema_version": {"const": "CST-TT-01"},
          "countermodel_id": {"pattern": "^CM-[0-9]{2}$"},
          "premises_status": {"const": "certified"},
          "conclusion_failure_status": {"const": "certified"},
          "minimality_status": {"const": "certified"}
        },
        "required": [
          "name",
          "toy_model_ref",
          "model_family",
          "finite_model_sha256",
          "claim_lanes",
          "scope",
          "search",
          "checker"
        ]
      }
    }
  ]
}
